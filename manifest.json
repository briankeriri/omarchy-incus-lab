{
  "schemaVersion": 1,
  "id": "keri.incus-lab",
  "name": "Incus Lab",
  "version": "0.1.1",
  "author": "keri",
  "license": "MIT",
  "description": "Bar widget for an isolated Incus VM lab: status, restore the golden snapshot, and open the host coding agent against it. Does not install Incus or edit packaged Omarchy.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Incus Lab",
    "description": "Isolated Incus VM sandbox for agent OS experiments",
    "category": "AI",
    "allowMultiple": false,
    "defaultSection": "right",
    "schema": [
      {
        "key": "instance",
        "type": "string",
        "label": "Instance name",
        "defaultValue": "omarchy-lab"
      },
      {
        "key": "snapshot",
        "type": "string",
        "label": "Golden snapshot",
        "defaultValue": "golden"
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
